# Pixashot Environment Variables

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CAPTURE=1 per second
RATE_LIMIT_SIGNED=5 per second

# Proxy Configuration
PROXY_SERVER=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Authentication and Security
URL_SIGNING_SECRET=

# Caching Configuration
CACHE_MAX_SIZE=0

# CORS Configuration
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false

# Other Configuration
AUTH_TOKEN=
PORT=8080

# Explanation of variables:
#
# RATE_LIMIT_ENABLED: Set to 'true' to enable rate limiting, 'false' to disable
# RATE_LIMIT_CAPTURE: Rate limit for capture requests, e.g., '10 per minute'
# RATE_LIMIT_SIGNED: Rate limit for signed URL requests, e.g., '5 per second'
#
# PROXY_SERVER: Address of the proxy server (if used)
# PROXY_PORT: Port of the proxy server
# PROXY_USERNAME: Username for proxy authentication (if required)
# PROXY_PASSWORD: Password for proxy authentication (if required)
#
# URL_SIGNING_SECRET: Secret key for signing URLs
#
# CACHE_MAX_SIZE: Maximum number of items to store in the cache (0 to disable caching)
#
# CORS_ENABLED: Set to 'true' to enable CORS headers and OPTIONS preflight handling
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins (supports chrome-extension://<id>)
# CORS_ALLOWED_METHODS: Comma-separated allowed HTTP methods for CORS
# CORS_ALLOWED_HEADERS: Comma-separated allowed request headers for CORS
# CORS_ALLOW_CREDENTIALS: Set to 'true' to include Access-Control-Allow-Credentials
#
# AUTH_TOKEN: Authentication token for API requests
# PORT: Port on which the service will run (default: 8080)
